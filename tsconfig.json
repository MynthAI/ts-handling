{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "paths": {
      "ts-handling": ["./src/index"],
      "error-parser": ["./src/error-parser"],
      "tests": ["./src/tests/index"],
      "tests/*": ["./src/tests/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
